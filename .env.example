# Optional: copy to .env at the repository root. Defaults already run locally.
# These are public LOCAL DEMONSTRATION credentials, not production secrets.
POSTGRES_DB=school_admission
POSTGRES_USER=school_admission
POSTGRES_PASSWORD=local_docker_only
BACKEND_PORT=8080
FRONTEND_PORT=8088
HOLD_DURATION_SECONDS=600
HOLD_EXPIRATION_POLL_SECONDS=5

# Server-side URL, resolved inside Docker; never compiled into the browser app.
# Use an http(s) origin without a path or trailing slash.
API_PROXY_TARGET=http://backend:8080

# Optional complete Npgsql connection string override for backend AND migrator.
# Normally leave unset: Compose derives it from POSTGRES_* above.
# Quote/escape special connection-string characters using Npgsql syntax.
# DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=school_admission;Username=school_admission;Password=local_docker_only;Timeout=5
