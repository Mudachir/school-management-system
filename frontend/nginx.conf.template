server {
    listen 80;
    server_name _;
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;

    # Docker DNS re-resolves the API after a backend container is recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream "${API_PROXY_TARGET}";

    location = /api {
        return 308 /api/;
    }

    location ^~ /api/ {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_intercept_errors off;
        # CreatedAtAction generates a backend path without the public /api prefix.
        proxy_redirect ~^https?://[^/]+(/classes/.*)$ $scheme://$http_host/api$1;
        proxy_redirect ~^(/classes/.*)$ $scheme://$http_host/api$1;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
